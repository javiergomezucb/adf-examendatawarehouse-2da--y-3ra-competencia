			"scriptLines": [
				"source(output(",
				"          id_efectivo as integer,",
				"          id_especialidad as integer,",
				"          id_unidad_actual as integer,",
				"          id_rango_actual as integer,",
				"          nombre as string,",
				"          ci as string,",
				"          fecha_nacimiento as string,",
				"          genero as string,",
				"          departamento_origen as string,",
				"          fecha_ingreso as string,",
				"          estado as string,",
				"          salario_mensual as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          id_especialidad as integer,",
				"          nombre as string,",
				"          area as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          id_estructura as integer,",
				"          id_padre as integer,",
				"          nivel as string,",
				"          nombre as string,",
				"          sigla as string,",
				"          tipo as string,",
				"          cobertura_departamentos as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source(output(",
				"          id_movimiento as integer,",
				"          id_efectivo as integer,",
				"          id_unidad_destino as integer,",
				"          id_rango as integer,",
				"          id_tipo as integer,",
				"          fecha_movimiento as string,",
				"          antiguedad_anios as string,",
				"          salario_mensual as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source4",
				"source(output(",
				"          id_operacion as integer,",
				"          id_tipo as integer,",
				"          id_unidad_resp as integer,",
				"          id_zona as integer,",
				"          nombre_operacion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          efectivos_desplegados as string,",
				"          vehiculos_utilizados as string,",
				"          duracion_dias as string,",
				"          costo_operacion as string,",
				"          resultado as string,",
				"          detenidos as string,",
				"          area_km2 as string,",
				"          incidentes as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source5",
				"source(output(",
				"          id_rango as integer,",
				"          nombre as string,",
				"          categoria as string,",
				"          nivel_jerarquico as integer,",
				"          abreviatura as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source6",
				"source(output(",
				"          id_tipo as integer,",
				"          nombre as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source7",
				"source(output(",
				"          id_tipo as integer,",
				"          nombre as string,",
				"          categoria as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source8",
				"source(output(",
				"          id_unidad as integer,",
				"          id_brigada as integer,",
				"          nombre as string,",
				"          codigo as string,",
				"          ciudad as string,",
				"          departamento as string,",
				"          tipo_cuartel as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source9",
				"source(output(",
				"          id_zona as integer,",
				"          nombre as string,",
				"          departamento as string,",
				"          frontera_con as string,",
				"          tipo_terreno as string,",
				"          altitud_msnm as integer,",
				"          nivel_riesgo as string,",
				"          acceso_carretero as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source10",
				"source1 derive(nombre = trim(regexReplace(regexReplace(replace(nombre, '\\t', ' '), '#', ''), ' +', ' ')),",
				"          genero = iif(lower(trim(genero)) == 'masculino' || lower(trim(genero)) == 'm', 'Masculino', iif(lower(trim(genero)) == 'femenino' || lower(trim(genero)) == 'f', 'Femenino', 'No Especificado')),",
				"          estado = iif(locate('act', lower(trim(estado))) > 0, 'Activo', iif(locate('baj', lower(trim(estado))) > 0 || locate('dado', lower(trim(estado))) > 0, 'Baja', iif(locate('r', lower(trim(estado))) > 0, 'Reserva', 'Activo'))),",
				"          salario_mensual = regexReplace(replace(replace(replace(upper(trim(salario_mensual)), 'BS', ''), '.', ''), ',', '.'), ' ', ''),",
				"          fecha_nacimiento = iif(regexMatch(trim(fecha_nacimiento), '^\\\\d{8}$'), concat(substring(trim(fecha_nacimiento), 7, 2), '-', substring(trim(fecha_nacimiento), 5, 2), '-', substring(trim(fecha_nacimiento), 1, 4)), iif(regexMatch(trim(fecha_nacimiento), '^\\\\d{4}/\\\\d{2}/\\\\d{2}$'), concat(substring(trim(fecha_nacimiento), 9, 2), '-', substring(trim(fecha_nacimiento), 6, 2), '-', substring(trim(fecha_nacimiento), 1, 4)), replace(trim(fecha_nacimiento), '/', '-'))),",
				"          fecha_ingreso = iif(regexMatch(trim(fecha_nacimiento), '^\\\\d{8}$'), concat(substring(trim(fecha_nacimiento), 7, 2), '-', substring(trim(fecha_nacimiento), 5, 2), '-', substring(trim(fecha_nacimiento), 1, 4)), iif(regexMatch(trim(fecha_nacimiento), '^\\\\d{4}/\\\\d{2}/\\\\d{2}$'), concat(substring(trim(fecha_nacimiento), 9, 2), '-', substring(trim(fecha_nacimiento), 6, 2), '-', substring(trim(fecha_nacimiento), 1, 4)), replace(trim(fecha_nacimiento), '/', '-'))),",
				"          departamento_origen = iif(locate('p', lower(trim(departamento_origen))) > 0, 'La Paz', iif(locate('c', lower(trim(departamento_origen))) > 0, 'Cochabamba', iif(locate('o', lower(trim(departamento_origen))) > 0, 'Oruro', iif(locate('t', lower(trim(departamento_origen))) > 0, 'Tarija', trim(departamento_origen))))),",
				"          ci = trim(upper(regexReplace(replace(replace(replace(ci, '.', ''), 'C.I.', ''), 'CI:', ''), ' ', '')))) ~> derivedColumn1",
				"source2 derive() ~> derivedColumn2",
				"source3 derive() ~> derivedColumn3",
				"source4 derive() ~> derivedColumn4",
				"source5 derive() ~> derivedColumn5",
				"source6 derive() ~> derivedColumn6",
				"source7 derive() ~> derivedColumn7",
				"source8 derive() ~> derivedColumn8",
				"source9 derive() ~> derivedColumn9",
				"source10 derive() ~> derivedColumn10",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_efectivo as integer,",
				"          id_especialidad as integer,",
				"          id_unidad_actual as integer,",
				"          id_rango_actual as integer,",
				"          nombre as string,",
				"          ci as string,",
				"          fecha_nacimiento as string,",
				"          genero as string,",
				"          departamento_origen as string,",
				"          fecha_ingreso as string,",
				"          estado as string,",
				"          salario_mensual as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_efectivo,",
				"          id_especialidad,",
				"          id_unidad_actual,",
				"          id_rango_actual,",
				"          nombre,",
				"          ci,",
				"          fecha_nacimiento,",
				"          genero,",
				"          departamento_origen,",
				"          fecha_ingreso,",
				"          estado,",
				"          salario_mensual",
				"     )) ~> sink1"
			]
		}
	}
}